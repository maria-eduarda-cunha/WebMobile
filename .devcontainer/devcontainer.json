{
  "name": "Next.js (projeto-02)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:26-trixie",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "none",
      "pnpmVersion": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "EditorConfig.EditorConfig"
      ]
    }
  },
  "postCreateCommand": "cd projeto-02 && pnpm install",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Next.js App",
      "onAutoForward": "notify"
    }
  }
}
